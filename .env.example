# PayrollSync Environment Variables
# Copy this file to .env and fill in your actual values

# Core Application
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/payrollsync

# Replit Integration
REPLIT_DOMAINS=your-app.replit.dev
REPL_ID=your-repl-id
ISSUER_URL=https://replit.com/oidc
SESSION_SECRET=your-session-secret-change-in-production

# Authentication
AUTH_SMOKE=false

# Email/SMTP Configuration
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password

# =============================================================================
# ENHANCED BACKGROUND JOBS & SCHEDULER CONFIGURATION
# =============================================================================
# 🚨 PRODUCTION SAFETY: ALL BACKGROUND JOBS DISABLED BY DEFAULT
# 🎯 REQUIREMENTS IMPLEMENTED:
#   1. Env-gated cron: disable nonessential jobs in prod until verified (ENABLE_*=false)
#   2. Idempotency: jobs tolerate retries (no duplicate incidents/emails)  
#   3. Per-job timeouts and circuit breakers so one failing integration doesn't spam logs

# Government System Integrations (HIGH PRIORITY)
ENABLE_GOVERNMENT_MONITORING=false   # ERGANI/e-EFKA/AADE status monitoring (every 30s)
ENABLE_ERGANI_SUBMISSION=false       # Automated payroll submission (every 5min)  
ENABLE_EMAIL_QUEUE=false             # Email notification processing (every 10s)
ENABLE_DB_CLEANUP=false              # Database maintenance (every hour)

# Security & Cleanup Jobs (CHANGED DEFAULTS)
ENABLE_SECURITY_CLEANUP=false        # Brute force cleanup (every hour) - was true
ENABLE_CACHE_CLEANUP=false           # Idempotency cache cleanup (every hour)
ENABLE_WEBAUTHN_CLEANUP=false        # WebAuthn challenge cleanup (every minute)
ENABLE_ANALYTICS_CLEANUP=false       # Analytics events cleanup (every hour)
ENABLE_PERF_CLEANUP=false            # Performance metrics cleanup (every hour)

# Business Logic Schedulers (CHANGED DEFAULTS)  
ENABLE_STATUS_MONITORING=false       # System status monitoring (every 30s) - was true
ENABLE_SECRET_ROTATION=false         # Secret rotation checks (hourly/daily) - was true
ENABLE_EVENT_QUEUE=false             # Event queue processing (every second)

# Legacy Feature Flags
STRICT_AUDIT=false

# Security
AUDIT_HMAC_SECRET=your-audit-hmac-secret-change-in-production

# External Service Keys (obtain from respective providers)
OPENAI_API_KEY=sk-your-openai-api-key
GOOGLE_CLOUD_PROJECT_ID=your-google-cloud-project-id
GOOGLE_CLOUD_PRIVATE_KEY_ID=your-key-id
GOOGLE_CLOUD_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key\n-----END PRIVATE KEY-----\n"
GOOGLE_CLOUD_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_CLOUD_CLIENT_ID=your-client-id

# Banking/Payment Integration
ALPHA_BANK_CLIENT_ID=your-alpha-bank-client-id
PIRAEUS_BANK_CLIENT_ID=your-piraeus-bank-client-id
EUROBANK_CLIENT_ID=your-eurobank-client-id
NBG_CLIENT_ID=your-nbg-client-id

# Government Integration (Greece)
ERGANI_API_KEY=your-ergani-api-key
EFKA_API_KEY=your-efka-api-key
AADE_API_KEY=your-aade-api-key

# Optional Development
DEBUG=false
LOG_LEVEL=info