# PayrollSync Environment Variables
# Copy this file to .env and fill in your actual values

# Core Application
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/payrollsync

# Replit Integration
REPLIT_DOMAINS=your-app.replit.dev
REPL_ID=your-repl-id
ISSUER_URL=https://replit.com/oidc
SESSION_SECRET=your-session-secret-change-in-production

# Authentication
AUTH_SMOKE=false

# Email/SMTP Configuration
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password

# Feature Flags
ENABLE_SECRET_ROTATION=false
ENABLE_STATUS_MONITORING=false
ENABLE_SECURITY_CLEANUP=false
STRICT_AUDIT=false

# Security
AUDIT_HMAC_SECRET=your-audit-hmac-secret-change-in-production

# External Service Keys (obtain from respective providers)
OPENAI_API_KEY=sk-your-openai-api-key
GOOGLE_CLOUD_PROJECT_ID=your-google-cloud-project-id
GOOGLE_CLOUD_PRIVATE_KEY_ID=your-key-id
GOOGLE_CLOUD_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key\n-----END PRIVATE KEY-----\n"
GOOGLE_CLOUD_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_CLOUD_CLIENT_ID=your-client-id

# Banking/Payment Integration
ALPHA_BANK_CLIENT_ID=your-alpha-bank-client-id
PIRAEUS_BANK_CLIENT_ID=your-piraeus-bank-client-id
EUROBANK_CLIENT_ID=your-eurobank-client-id
NBG_CLIENT_ID=your-nbg-client-id

# Government Integration (Greece)
ERGANI_API_KEY=your-ergani-api-key
EFKA_API_KEY=your-efka-api-key
AADE_API_KEY=your-aade-api-key

# Optional Development
DEBUG=false
LOG_LEVEL=info