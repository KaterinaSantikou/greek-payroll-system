# =============================================================================
# PayrollSync Environment Configuration Example
# =============================================================================
# Copy this file to .env and fill in the actual values
# This file shows all required and optional environment variables

# =============================================================================
# CORE APPLICATION SETTINGS
# =============================================================================

# Environment (development, staging, production)
NODE_ENV=development

# Database connection string (REQUIRED)
DATABASE_URL=postgresql://username:password@host:port/database

# Replit-specific configuration (REQUIRED in production)
REPL_ID=your-repl-id

# Session secret for authentication (REQUIRED - generate with: openssl rand -hex 64)
SESSION_SECRET=your-session-secret-key-here

# Base URL for the application (REQUIRED for email links)
BASE_URL=https://your-app.replit.app

# =============================================================================
# OBJECT STORAGE CONFIGURATION
# =============================================================================

# Object storage paths for public assets (comma-separated)
PUBLIC_OBJECT_SEARCH_PATHS=/bucket-name/public

# Private object storage directory
PRIVATE_OBJECT_DIR=/bucket-name/.private

# =============================================================================
# EMAIL & SMTP CONFIGURATION
# =============================================================================

# SMTP server configuration for sending emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-password

# From email address for system emails
FROM_EMAIL=noreply@payrollsync.gr

# =============================================================================
# SECURITY & ACCESS CONTROL
# =============================================================================

# Service role key for RLS bypass (SERVER-ONLY - never expose to client)
SERVICE_ROLE_KEY=your-service-role-key-for-rls-bypass

# Allowed IP addresses for authentication (comma-separated, optional)
AUTH_ALLOWED_IPS=127.0.0.1,::1

# =============================================================================
# FEATURE FLAGS & MODULES
# =============================================================================

# Enable/disable core modules (true/false)
ENABLE_ONCALL=true
ENABLE_RUNBOOKS=true
ENABLE_LOGGING=true

# Background job processing feature flags
ENABLE_GOVERNMENT_MONITORING=true
ENABLE_ERGANI_SUBMISSION=true
ENABLE_EMAIL_QUEUE=true

# Greek payroll specific features
ENABLE_DIGITAL_WORK_CARD=true
ENABLE_HOTEL_FEATURES=false
ENABLE_TIP_POOLING=false
ENABLE_OVERTIME_PREVENTION=true
ENABLE_PAY_EQUITY_MONITORING=true
ENABLE_ESRS_S1=false

# Security and monitoring features
ENABLE_PERFORMANCE_MONITORING=true
ENABLE_AUDIT_LOGGING=true
ENABLE_METRICS=true

# =============================================================================
# OBSERVABILITY & MONITORING
# =============================================================================

# Sentry DSN for error tracking (optional)
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Enable Sentry in non-production (true/false)
VITE_ENABLE_SENTRY=false

# Application version for error tracking (optional)
VITE_APP_VERSION=1.0.0

# =============================================================================
# GREEK PAYROLL SPECIFIC CLIENT CONFIGURATION  
# =============================================================================

# ERGANI II API endpoint for digital work cards (optional - defaults to /api/ergani)
VITE_ERGANI_API_ENDPOINT=/api/ergani

# Company AFM for ERGANI II integration (REQUIRED for Greek payroll features)
VITE_COMPANY_AFM=your-company-afm-here

# =============================================================================
# SECURITY & CONTENT SECURITY POLICY
# =============================================================================

# External hosts allowed by Content Security Policy (comma-separated)
# Only needed if you want to restrict connect-src from default "https:" wildcard
# Examples: Supabase, Sentry, Analytics APIs, etc.
CSP_CONNECT_SRC=https://api.example.com,https://sentry.io

# =============================================================================
# EXTERNAL SERVICES & API KEYS
# =============================================================================

# OpenAI API key (REQUIRED for AI-powered payroll agent)
OPENAI_API_KEY=sk-your-openai-api-key-here

# GitHub token (REQUIRED for agent PR creation and version control)
GITHUB_TOKEN=ghp_your-github-personal-access-token

# Stripe payment processing (for billing/subscriptions)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# SendGrid email service (for notifications and payslips)
SENDGRID_API_KEY=SG.your-sendgrid-api-key

# Sentry server-side error monitoring (optional)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Greek government API credentials (REQUIRED for payroll compliance)
ERGANI_API_KEY=your-ergani-api-key
ERGANI_API_ENDPOINT=https://ergani.gov.gr/api
VITE_ERGANI_API_TOKEN=your-ergani-client-token

# EFKA (Social Security) API credentials
EFKA_API_KEY=your-efka-api-key
EFKA_API_ENDPOINT=https://api.efka.gov.gr

# AADE (Tax Authority) integration
AADE_API_KEY=your-aade-api-key
AADE_API_ENDPOINT=https://api.aade.gr

# Banking integration credentials (for SEPA payments) 
ALPHA_BANK_API_KEY=your-alpha-bank-api-key
PIRAEUS_BANK_API_KEY=your-piraeus-bank-api-key

# =============================================================================
# DEVELOPMENT & TESTING
# =============================================================================

# Enable debug logging in development
DEBUG=payrollsync:*

# Test database URL (for running tests)
TEST_DATABASE_URL=postgresql://username:password@localhost:5433/payrollsync_test

# Mock external services in development (true/false)
MOCK_EXTERNAL_SERVICES=true

# Disable DR seeding to prevent schema errors in development
ENABLE_DR_SEEDING=false

# =============================================================================
# GREEK LAW & COMPLIANCE VERSION FLAGS
# =============================================================================

# Greek labor law version tracking (for compliance versioning)
GREEK_LAW_VERSION=2024.12
EFKA_RATES_VERSION=2024.12
TAX_BRACKETS_VERSION=2024.12
MINIMUM_WAGE_VERSION=2024.12
CBA_VERSION=2024.12

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Server port (default: 5000)
PORT=5000

# Application base URL (auto-detected in Replit)
APP_BASE_URL=https://your-app.replit.app

# Replit domains for authentication (auto-set in Replit environment)
REPLIT_DOMAINS=your-repl-slug.username.replit.app

# OIDC issuer URL (default: https://replit.com/oidc)
ISSUER_URL=https://replit.com/oidc

# Force production mode (useful for testing production builds locally)
FORCE_PRODUCTION=false

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# =============================================================================
# SECURITY NOTES
# =============================================================================
# 
# IMPORTANT: Never commit .env files with real values to version control!
# Add .env to your .gitignore to prevent accidental commits.
# 
# For security, use strong, randomly generated values for:
# - SESSION_SECRET (generate with: openssl rand -hex 64)
# - SERVICE_ROLE_KEY (if using RLS bypass)
# 
# Always use different values for development, staging, and production environments.
# 
# Greek government API keys should be obtained from official sources:
# - ERGANI II: https://www.ergani.gov.gr/
# - EFKA: https://www.efka.gov.gr/
# - AADE: https://www.aade.gr/
