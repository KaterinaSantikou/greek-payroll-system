# =============================================================================
# PayrollSync Environment Configuration Example
# =============================================================================
# Copy this file to .env and fill in the actual values
# This file shows all required and optional environment variables

# =============================================================================
# CORE APPLICATION SETTINGS
# =============================================================================

# Environment (development, staging, production)
NODE_ENV=development

# Database connection string (REQUIRED)
DATABASE_URL=postgresql://username:password@host:port/database

# Replit-specific configuration (REQUIRED in production)
REPL_ID=your-repl-id

# Session secret for authentication (REQUIRED - generate with: openssl rand -hex 64)
SESSION_SECRET=your-session-secret-key-here

# Base URL for the application (REQUIRED for email links)
BASE_URL=https://your-app.replit.app

# =============================================================================
# OBJECT STORAGE CONFIGURATION
# =============================================================================

# Object storage paths for public assets (comma-separated)
PUBLIC_OBJECT_SEARCH_PATHS=/bucket-name/public

# Private object storage directory
PRIVATE_OBJECT_DIR=/bucket-name/.private

# =============================================================================
# EMAIL & SMTP CONFIGURATION
# =============================================================================

# SMTP server configuration for sending emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-password

# From email address for system emails
FROM_EMAIL=noreply@payrollsync.gr

# =============================================================================
# SECURITY & ACCESS CONTROL
# =============================================================================

# Service role key for RLS bypass (SERVER-ONLY - never expose to client)
SERVICE_ROLE_KEY=your-service-role-key-for-rls-bypass

# Allowed IP addresses for authentication (comma-separated, optional)
AUTH_ALLOWED_IPS=127.0.0.1,::1

# =============================================================================
# FEATURE FLAGS & MODULES
# =============================================================================

# Enable/disable core modules (true/false)
ENABLE_ONCALL=true
ENABLE_RUNBOOKS=true
ENABLE_LOGGING=true

# =============================================================================
# OBSERVABILITY & MONITORING
# =============================================================================

# Sentry DSN for error tracking (optional)
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Enable Sentry in non-production (true/false)
VITE_ENABLE_SENTRY=false

# Application version for error tracking (optional)
VITE_APP_VERSION=1.0.0

# =============================================================================
# GREEK PAYROLL SPECIFIC CLIENT CONFIGURATION  
# =============================================================================

# ERGANI II API endpoint for digital work cards (optional - defaults to /api/ergani)
VITE_ERGANI_API_ENDPOINT=/api/ergani

# Company AFM for ERGANI II integration (REQUIRED for Greek payroll features)
VITE_COMPANY_AFM=your-company-afm-here

# =============================================================================
# SECURITY & CONTENT SECURITY POLICY
# =============================================================================

# External hosts allowed by Content Security Policy (comma-separated)
# Only needed if you want to restrict connect-src from default "https:" wildcard
# Examples: Supabase, Sentry, Analytics APIs, etc.
CSP_CONNECT_SRC=https://api.example.com,https://sentry.io

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================

# Greek government API credentials (if applicable)
ERGANI_API_KEY=your-ergani-api-key
ERGANI_API_ENDPOINT=https://ergani.gov.gr/api

# Banking integration credentials (if applicable) 
ALPHA_BANK_API_KEY=your-alpha-bank-api-key
PIRAEUS_BANK_API_KEY=your-piraeus-bank-api-key

# =============================================================================
# DEVELOPMENT & TESTING
# =============================================================================

# Enable debug logging in development
DEBUG=payrollsync:*

# Test database URL (for running tests)
TEST_DATABASE_URL=postgresql://username:password@localhost:5433/payrollsync_test

# Mock external services in development (true/false)
MOCK_EXTERNAL_SERVICES=true

# Disable DR seeding to prevent schema errors in development
ENABLE_DR_SEEDING=false
